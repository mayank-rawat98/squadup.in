# Copy to .env.local and adjust:  cp .env.example .env.local
#
# Every value here is a local-development placeholder. The credentials only
# need to agree with each other, because `npm run docker:up` creates the
# Postgres, MongoDB, RabbitMQ and MinIO users from these same variables.
# Never reuse them anywhere reachable from the internet.

# === APP ===
NODE_ENV=development
CLIENT_URL=http://localhost:3001
OPS_URL=http://localhost:3002
API_PORT=8080
WEB_PORT=3001
OPS_PORT=3002
ADMIN_EMAIL=admin@example.com

# === WEB APP (exposed to the browser) ===
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === SECRETS ===
# Any long random string works. Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
STAFF_JWT_SECRET=change-me-staff
STAFF_JWT_ACCESS_TTL_MIN=15
STAFF_JWT_REFRESH_TTL_MIN=10080
FINGERPRINT_HMAC_SECRET=change-me-fingerprint
UNSUBSCRIBE_TOKEN_SECRET=change-me-unsubscribe
TWO_FACTOR_ENCRYPTION_KEY=change-me-2fa
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_REMEMBER_TTL_MIN=43200
JWT_REFRESH_TTL_MIN=10080

# === POSTGRES ===
DB_TYPE=postgres
# TLS to Postgres: set POSTGRES_SSL=true (or PGSSLMODE=require) for managed DBs
POSTGRES_SSL=false
# PGSSLMODE=require
# PGSSL_REJECT_UNAUTHORIZED=false
TYPEORM_LOGGING=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=squadup
POSTGRES_USER=squadup
POSTGRES_PASSWORD=squadup

# === REDIS ===
# The dev container runs without auth, so leave these empty.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# === MONGODB (audit logs) ===
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=squadup
MONGO_INITDB_ROOT_PASSWORD=squadup
MONGO_INITDB_DATABASE=squadup_audits
MONGO_URI=mongodb://squadup:squadup@localhost:27017/?appName=squadup-dev

# === RABBITMQ ===
RABBITMQ_DEFAULT_USER=squadup
RABBITMQ_DEFAULT_PASS=squadup
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://squadup:squadup@localhost:5672
RABBITMQ_QUEUE_AUDIT_LOGS=audit_logs_queue
RABBITMQ_EXCHANGE_AUDIT=audit_exchange
RABBITMQ_DLX_EXCHANGE=audit_dlx_exchange
RABBITMQ_DLQ_QUEUE=audit_dlq_queue

# === MINIO (file storage) ===
MINIO_ENDPOINT=localhost
MINIO_EXTERNAL_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=squadup
MINIO_SECRET_KEY=squadup-secret

# === SWAGGER (API docs basic auth) ===
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# === PASSKEYS ===
RP_ID=localhost
RP_NAME=Squadup

# === OPTIONAL THIRD-PARTY SERVICES ===
# Only the features that use them fail without these.
MAILTR_API_URL=https://api.mailtr.co
MAILTR_API_KEY=
MAILTR_FROM_EMAIL=
MAILTR_TIMEOUT_MS=10000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IP_INFO_SECRET=
TWO_FACTOR_SMS_API_KEY=
TWO_FACTOR_SMS_TEMPLATE=

# === BACKUP ===
# Name of the backup worker container the API triggers through the Docker socket
BACKUP_WORKER_CONTAINER=squadup-backup-worker
