{
  "name": "@squadup.in/ops",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:app",
      "scope:ops"
    ],
    "targets": {
      "serve": {
        "options": {
          "cwd": "apps/ops",
          "command": "next dev --port 3002"
        }
      },
      "start": {
        "options": {
          "cwd": "apps/ops",
          "command": "next start --port 3002"
        }
      },
      "serve-static": {
        "options": {
          "cwd": "apps/ops",
          "command": "next start --port 3002"
        }
      },
      "build": {
        "options": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          },
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "outputs": [],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/ops",
          "command": "tsc --noEmit -p tsconfig.json"
        }
      }
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@squadup.in/ui": "^0.0.1",
    "@tanstack/react-query": "^5.104.0",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  }
}
