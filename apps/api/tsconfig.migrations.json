{
  // Standalone CommonJS compile of the TypeORM data source + migration files
  // only, used two ways:
  //   - ts-node (transpile-only) for the `npm run typeorm` scripts in dev;
  //   - `tsc -p` in the API image, emitting runnable JS to dist-migrations for
  //     the deploy's `migration:run`.
  // Deliberately does NOT extend tsconfig.base.json (which sets
  // emitDeclarationOnly/composite) — the image needs real JS emit. The
  // compile follows imports, so it also pulls in the few app constant files a
  // migration references (mailer and staff constants), but no entities.
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2021",
    "lib": ["es2022"],
    "outDir": "dist-migrations",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/database/data-source.ts", "src/database/migrations/**/*.ts"]
}
