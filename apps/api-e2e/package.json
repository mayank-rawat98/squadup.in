{
  "name": "@squadup.in/api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:e2e",
      "scope:api"
    ],
    "implicitDependencies": [
      "@squadup.in/api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@squadup.in/api:build",
          "@squadup.in/api:serve"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
